{
  "name": "tay-tube-pc",
  "version": "1.3.0",
  "description": "Desktop YouTube Player Application for PC - Tày Tube",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:renderer": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "build:renderer": "vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:release": "tauri build --bundles nsis && node scripts/export-release.mjs",
    "start": "tauri dev"
  },
  "keywords": [
    "youtube",
    "tauri",
    "rust",
    "react",
    "vite",
    "streaming",
    "proxy",
    "sponsorblock"
  ],
  "author": "Tay Tube Team",
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shaka-player": "^5.3.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.0",
    "vite": "^6.2.0"
  }
}
